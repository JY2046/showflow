# Default: local inference. Real weights remain in .runtime/ollama-models.
SHOWFLOW_AI_PROVIDER=ollama
SHOWFLOW_OLLAMA_MODEL=qwen2.5:1.5b
SHOWFLOW_OLLAMA_URL=http://127.0.0.1:11434
# Default research: live public catalog. Optional cloud web search requires credits.
SHOWFLOW_SEARCH_PROVIDER=catalog
# Optional cloud provider, explicitly enabled server-side:
# SHOWFLOW_AI_PROVIDER=openai
# OPENAI_API_KEY=
# SHOWFLOW_AI_MODEL=gpt-4.1-mini
# SHOWFLOW_SEARCH_PROVIDER=openai
# SHOWFLOW_SEARCH_MODEL=gpt-4.1
